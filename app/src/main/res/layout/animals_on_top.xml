<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AnimalsOnTop">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Top half: animal image (centered horizontally and vertically) -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/apple" />

        <!-- Bottom half: three letter buttons -->
        <LinearLayout
            android:id="@+id/lettersContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mainLetter1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/letter_button_background"
                android:clickable="true"
                android:gravity="center"
                android:maxLines="1"
                android:padding="8dp"
                android:soundEffectsEnabled="false"
                android:text="A" />

            <TextView
                android:id="@+id/mainLetter2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/letter_button_background"
                android:clickable="true"
                android:gravity="center"
                android:maxLines="1"
                android:padding="8dp"
                android:soundEffectsEnabled="false"
                android:text="B" />

            <TextView
                android:id="@+id/mainLetter3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/letter_button_background"
                android:clickable="true"
                android:gravity="center"
                android:maxLines="1"
                android:padding="8dp"
                android:soundEffectsEnabled="false"
                android:text="C" />

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>